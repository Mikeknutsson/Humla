NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback until a tenant saves Google Maps settings in Humla Hub.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Route Optimization uses a server-only Google service account JSON from the billing project.
# Set the owning Humla tenant ID to limit use of this connection.
GOOGLE_ROUTE_OPTIMIZATION_TENANT_ID=
GOOGLE_ROUTE_OPTIMIZATION_SERVICE_ACCOUNT_JSON=
